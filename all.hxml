-lib heaps
-lib castle
-lib hxbit
--macro include('h3d')
--macro include('h2d',true,['h2d.domkit'])
--macro include('hxsl',true,['hxsl.Macros','hxsl.CacheFileBuilder','hxsl.Checker'])
--macro include('hxd',true,['hxd.res.FileTree','hxd.Res','hxd.impl.BitsBuilder','hxd.fmt.pak.Build','hxd.snd.openal','hxd.res.Config'])
--no-output
-D apicheck
--each

-js heaps.js
-xml heaps_js.xml

--next

-hl heaps.hl
-lib limen
-lib hlopenal
-xml heaps_hl.xml
hxsl.CacheFileBuilder
-D default_gfx_opengl
-D gfx_opengl
-D hl-ver=1.15.0

--next

-hl heaps.hl
-lib limen
-lib hlopenal
-xml heaps_vulkan.xml
hxsl.CacheFileBuilder
-D default_gfx_vulkan
-D gfx_vulkan
-D hl-ver=1.15.0

--next

-hl heaps.hl
-lib limen
-lib hlopenal
-xml heaps_d3d11.xml
-D default_gfx_dx11
-D gfx_dx11
-D hl-ver=1.15.0

--next

-hl heaps.hl
-lib limen
-lib hlopenal
-D default_gfx_dx12
-D gfx_dx12
-xml heaps_d3d12.xml
-D hl-ver=1.15.0
